# Server-only snapshot configuration. Never put credentials in NEXT_PUBLIC_*.
# Local SQLite development (absolute path required):
OMBELLE_SNAPSHOT_BACKEND=sqlite
OMBELLE_SNAPSHOT_DB_PATH=
OMBELLE_PUBLIC_ORIGIN=http://127.0.0.1:3000
OMBELLE_SNAPSHOT_RATE_SECRET=

# Vercel/Neon: set BACKEND=postgres; the integration supplies these secrets.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Production endpoint hostname, without credentials. Required on previews so
# accidental use of the production endpoint fails closed (pooler normalized).
OMBELLE_SNAPSHOT_PRODUCTION_DB_HOST=
# Non-Vercel public hosts only: exact trusted ingress client IP header name.
OMBELLE_SNAPSHOT_CLIENT_IP_HEADER=
# Optional local development only. Leave unset on hosted deployments.
NEXT_PUBLIC_OMBELLE_PREVIEW_ORIGIN=
