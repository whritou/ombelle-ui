# Shell scripts run from WSL and Linux CI; keep LF even on Windows checkouts.
*.sh text eol=lf

# Byte-exact output of the pinned shadcn init; theme-merge tests compare it.
fixtures/shadcn/** -text

# Generated by scripts/sync-schema.mjs and scripts/sync-catalog.mjs with LF
# endings. Keep checkouts LF too, so a Windows build does not dirty the tree.
packages/catalog/src/generated.ts text eol=lf
packages/contracts/src/*-schema.ts text eol=lf
