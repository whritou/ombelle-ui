{
  "name": "ombelle-foundation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "audit:workspace": "pnpm audit",
    "build:packages": "node scripts/sync-schema.mjs && node scripts/sync-catalog.mjs && node scripts/build.mjs",
    "version:set": "node scripts/set-version.mjs",
    "pack:cli": "node scripts/pack-cli.mjs",
    "build:editor-worker": "node scripts/build-editor-worker.mjs",
    "build": "pnpm build:packages",
    "typecheck": "node scripts/sync-schema.mjs && node scripts/sync-catalog.mjs && tsc --noEmit",
    "test:unit": "vitest run packages apps/www/src --reporter=default --reporter=json --outputFile=.artifacts/unit-results.json",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration --reporter=default --reporter=json --outputFile=.artifacts/integration-results.json",
    "test:hosted-storage": "node --env-file-if-exists=.env.hosted.local node_modules/vitest/vitest.mjs run --config vitest.postgres.config.ts",
    "test": "pnpm build:packages && pnpm test:unit && pnpm test:integration",
    "generate:preview": "tsx scripts/generate-preview.ts",
    "prepare:consumers": "tsx scripts/prepare-consumers.ts",
    "build:consumers": "tsx scripts/build-consumers.ts",
    "build:preview": "vite build apps/preview --config apps/preview/vite.config.ts",
    "build:www": "pnpm --filter @ombelle/www build",
    "test:e2e": "playwright test",
    "dev:preview": "vite apps/preview --config apps/preview/vite.config.ts",
    "dev:www": "pnpm --filter @ombelle/www dev",
    "snapshots:init": "tsx scripts/snapshot-store.ts init",
    "snapshots:withdraw": "tsx scripts/snapshot-store.ts withdraw",
    "snapshots:unwithdraw": "tsx scripts/snapshot-store.ts unwithdraw",
    "snapshots:backup": "tsx scripts/snapshot-store.ts backup",
    "check:foundation": "node --import tsx scripts/check-foundation.mjs",
    "check:foundation:quality": "node --import tsx scripts/check-foundation.mjs --group quality",
    "check:foundation:consumers": "node --import tsx scripts/check-foundation.mjs --group consumers",
    "check:foundation:aggregate": "node --import tsx scripts/check-foundation.mjs --aggregate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "json-schema-to-ts": "3.1.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
