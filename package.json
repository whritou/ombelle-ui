{
  "name": "ombelle-foundation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "build:packages": "node scripts/sync-schema.mjs && node scripts/sync-catalog.mjs && node scripts/build.mjs",
    "build": "pnpm build:packages",
    "typecheck": "node scripts/sync-schema.mjs && node scripts/sync-catalog.mjs && tsc --noEmit",
    "test:unit": "vitest run packages",
    "test:integration": "vitest run tests/integration",
    "test": "pnpm build:packages && pnpm test:unit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "json-schema-to-ts": "3.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "tsx": "4.23.15",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
