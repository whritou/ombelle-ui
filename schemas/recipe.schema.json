{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.example.com/schemas/recipe-1.0.json",
  "title": "Proposed UI Library Button Recipe Version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "component", "presetRef", "props", "content", "overrides"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$"},
    "revision": {"type": "integer", "minimum": 1},
    "component": {"const": "button"},
    "presetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "catalogRelease", "compilerVersion"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$"},
        "revision": {"type": "integer", "minimum": 1},
        "catalogRelease": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "compilerVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}
      }
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": {"enum": ["default", "secondary", "outline", "ghost", "link", "destructive"]},
        "size": {"enum": ["sm", "default", "lg", "icon"]},
        "disabled": {"type": "boolean"},
        "loading": {"type": "boolean"},
        "type": {"enum": ["button", "submit", "reset"]}
      }
    },
    "content": {"type": "string", "minLength": 1, "maxLength": 200},
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "description": "A reviewed lucide-react icon. In icon-only mode the content is the accessible label and no text is shown.",
      "properties": {
        "name": {"enum": ["arrow-left", "arrow-right", "check", "chevron-right", "download", "external-link", "plus", "search", "send", "settings", "trash", "upload"]},
        "position": {"enum": ["start", "end"]},
        "iconOnly": {"type": "boolean"}
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radiusRem": {"type": "number", "minimum": 0, "maximum": 2},
        "borderWidthPx": {"type": "number", "minimum": 0, "maximum": 4},
        "minHeightPx": {"type": "number", "minimum": 24, "maximum": 80},
        "shadowOffsetXPx": {"type": "number", "minimum": -16, "maximum": 16},
        "shadowOffsetYPx": {"type": "number", "minimum": -16, "maximum": 16},
        "paddingXPx": {"type": "number", "minimum": 0, "maximum": 48, "description": "Inline padding of the sm, default and lg sizes. The icon size and icon-only Buttons stay square."},
        "paddingYPx": {"type": "number", "minimum": 0, "maximum": 24, "description": "Block padding of the sm, default and lg sizes. The icon size and icon-only Buttons stay square."},
        "gapPx": {"type": "number", "minimum": 0, "maximum": 24, "description": "Space between the icon and the label."},
        "fontWeight": {"type": "integer", "minimum": 300, "maximum": 800, "multipleOf": 100},
        "fontSizePx": {"type": "number", "minimum": 11, "maximum": 24},
        "letterSpacingEm": {"type": "number", "minimum": -0.05, "maximum": 0.2},
        "uppercase": {"type": "boolean"},
        "glassOpacity": {"type": "number", "minimum": 0.25, "maximum": 1, "description": "Liquid glass only, like every glass* override: replaces the preset's value on this Button and is checked for contrast warnings. Ignored by other style families."},
        "glassBlurPx": {"type": "number", "minimum": 0, "maximum": 40},
        "glassBackdropContrast": {"type": "number", "minimum": 0.3, "maximum": 1.6},
        "glassSheen": {"type": "number", "minimum": 0, "maximum": 1},
        "glassRim": {"type": "number", "minimum": 0, "maximum": 1},
        "glassHalo": {"type": "number", "minimum": 0, "maximum": 1},
        "glassDepth": {"type": "number", "minimum": 0, "maximum": 1},
        "glassMotion": {"type": "number", "minimum": 0, "maximum": 1},
        "glassDispersion": {"type": "number", "minimum": 0, "maximum": 1},
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-mode Button colors. Omitted base roles fall back to the preset tokens the selected variant reads; omitted hover and pressed roles keep the style family's own hover and pressed colors in that mode.",
          "properties": {
            "light": {"$ref": "#/$defs/buttonColors"},
            "dark": {"$ref": "#/$defs/buttonColors"}
          }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "maxLength": 80,
      "description": "Initial syntax filter only. A real color parser and semantic validation are mandatory.",
      "anyOf": [
        {"pattern": "^#[0-9A-Fa-f]{6}$"},
        {"pattern": "^oklch\\([0-9.]+%? [0-9.]+ [0-9.]+(?: / [0-9.]+%?)?\\)$"}
      ]
    },
    "buttonColors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {"$ref": "#/$defs/color"},
        "foreground": {"$ref": "#/$defs/color"},
        "border": {"$ref": "#/$defs/color"},
        "hoverBackground": {"$ref": "#/$defs/color"},
        "hoverForeground": {"$ref": "#/$defs/color"},
        "hoverBorder": {"$ref": "#/$defs/color"},
        "pressedBackground": {"$ref": "#/$defs/color"},
        "pressedForeground": {"$ref": "#/$defs/color"},
        "pressedBorder": {"$ref": "#/$defs/color"}
      }
    }
  }
}
